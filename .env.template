# LLM Provider Configuration
# Set LLM_PROVIDER to "sap-baf" for SAP Business Agent Foundation mode
LLM_PROVIDER=sap-baf

# SAP AI Core / GenAI Hub Credentials (from Service Key)
AICORE_CLIENT_ID=your-client-id
AICORE_CLIENT_SECRET=your-client-secret
AICORE_AUTH_URL=https://your-auth-url.authentication.sap.hana.ondemand.com
AICORE_BASE_URL=https://api.ai.prod.eu-central-1.aws.ml.hana.ondemand.com/v2
AICORE_RESOURCE_GROUP=default
LLM_DEPLOYMENT_ID=your-deployment-id

# External Integrations
OPENAI_API_KEY=your-openai-key (optional if using BAF)
GOOGLE_CALENDAR_SECRET_PATH=credentials.json
GOOGLE_MAPS_API_KEY=your-google-maps-key
OWM_API_KEY=your-openweathermap-key

# Email Configuration
IMAP_HOST=imap.example.com
IMAP_PORT=993
SMTP_HOST=smtp.example.com
SMTP_PORT=587
EMAIL_USER=you@example.com
EMAIL_PASS=app-specific-password
